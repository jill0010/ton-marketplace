# Copy to wallets.toml locally. Never commit wallets.toml or mnemonic values.
# Set DEPLOYER_MNEMONIC in a local secure wallet store, or use --tonconnect for the deployer.
# For emulation/testnet, TREASURY_MNEMONIC supplies a separate treasury wallet.
# For mainnet --tonconnect, set PLATFORM_TREASURY_ADDRESS to the public fee wallet address;
# no treasury private key is needed. Never commit wallets.toml or mnemonic values.

[wallets.deployer]
kind = "v5r1"
workchain = 0
keys = { mnemonic-env = "DEPLOYER_MNEMONIC" }

[wallets.treasury]
kind = "v5r1"
workchain = 0
keys = { mnemonic-env = "TREASURY_MNEMONIC" }
